text 81 weapon.1.name
text 82 weapon.2.name
text 83 weapon.3.name
text 84 weapon.4.name
text 85 weapon.5.name
text 86 weapon.6.name
text 87 weapon.7.name
text 88 weapon.8.name
text 89 weapon.9.name
text 8A weapon.10.name
text 8B weapon.11.name
field 80 weapon.0.count
field 81 weapon.1.count
field 82 weapon.2.count
field 83 weapon.3.count
field 84 weapon.4.count
field 85 weapon.5.count
bar 80 weapon.0.bar
bar 81 weapon.1.bar
bar 82 weapon.2.bar
bar 83 weapon.3.bar
bar 84 weapon.4.bar
bar 85 weapon.5.bar

# controls
button A5 trigger.1
button A6 trigger.2
button A7 trigger.3
axis A0 throttle 0 0x340
